# Configuration Pharmacie Émeraude — copiez ce fichier en .env et adaptez les valeurs

# Serveur
PORT=3000
NODE_ENV=development

# Secret de signature des sessions (obligatoire en production, longue chaîne aléatoire)
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Mot de passe du compte "admin" créé au premier démarrage
ADMIN_PASSWORD=admin123

# Base de données MySQL (XAMPP en local : root sans mot de passe)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pharmacie_emeraude

# Base hébergée (Aiven…) : connexion chiffrée obligatoire
# DB_SSL=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Ajoute des produits, clients et ventes d'exemple si la base est vide
# (activé par défaut hors production)
SEED_DEMO=true

# Logs : error, warn, info, debug
LOG_LEVEL=info
